# TradingSystem Configuration

# Application
APP_NAME=TradingSystem
DEBUG=false

# Database (same TimescaleDB as RateService)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rateservice

# RateService integration
RATESERVICE_URL=http://localhost:8000

# Oanda API (for live trading - Phase 6)
OANDA_API_KEY=your_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_API_URL=https://api-fxtrade.oanda.com

# Trading parameters
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false

# Risk management
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=5

# Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL_MINUTES=1

# Twilio SMS (for critical alerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890
TWILIO_ALERT_ON_WARNING=false

# Log monitoring
LOG_MONITOR_WINDOW_SECONDS=300
LOG_MONITOR_ERROR_THRESHOLD=10
LOG_MONITOR_WARNING_THRESHOLD=50
