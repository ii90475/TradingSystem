# TradingSystem Configuration

# Application
APP_NAME=TradingSystem
DEBUG=false

# Database (same TimescaleDB as RateService)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rateservice

# RateService integration
RATESERVICE_URL=http://localhost:8000

# Oanda API (for live trading - Phase 6)
OANDA_API_KEY=your_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_API_URL=https://api-fxtrade.oanda.com

# Trading parameters
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false

# Risk management
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=5
